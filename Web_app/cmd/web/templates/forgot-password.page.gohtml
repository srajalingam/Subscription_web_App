{{template "base" .}}
{{define "title"}}
    Forgot Password
{{end}}
{{define "content"}}
    <div class="alert alert-danger text-center d-none" role="alert" id="forgot-password-messages"></div>

        <form method="POST" action="" class="w-50 needs-validation " id="forgot-password-form" novalidate="novalidate" autocomplete="off">
        
            <h2 class="text-xl font-bold mb-2 text-center">Forgot Password</h2> 
            <hr>
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input type="email" class="form-control" id="email" name="email" placeholder="e.g., john.doe@example.com" required>
            </div>
            <hr>
            <button type="button" class="btn btn-primary w-100" onclick="val()">Send Reset Link</button>
        </form>
{{end}}

{{define "js"}}
    <script>
         let forgotPasswordMessages = document.getElementById('forgot-password-messages');

    function showError(message) {
        forgotPasswordMessages.classList.add('alert-danger');
        forgotPasswordMessages.classList.remove('alert-success');
        forgotPasswordMessages.textContent = message;
        forgotPasswordMessages.classList.remove('d-none');
    }
    function showSuccess() {
        forgotPasswordMessages.classList.add('alert-success');
        forgotPasswordMessages.classList.remove('alert-danger');
        forgotPasswordMessages.textContent = 'Password reset email sent!';
        forgotPasswordMessages.classList.remove('d-none');
    }
    function val() {
         this.event.preventDefault();
            this.event.stopPropagation();
        let form = document.getElementById('forgot-password-form');
        if(form.checkValidity() === false) {
           
           form.classList.add('was-validated');
           return;
        }
        form.classList.remove('was-validated');

        let payload = {
            email: document.getElementById('email').value,
        };
        const requestOptions = {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json',
            },
            body: JSON.stringify(payload)
        };
        fetch("{{.API}}/api/forgot-password", requestOptions)
            .then(response => response.json())
            .then(response => {
                console.log(response);
                if((response.error) == false) {
                  showSuccess();
                } else {
                    showError(response.message);
                }
            })
        
    }
    </script>
{{end}}