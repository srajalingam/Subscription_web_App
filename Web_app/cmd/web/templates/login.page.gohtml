{{template "base" .}}

{{define "title"}}
    Login
{{end}}

{{define "content"}}
    <div class="alert alert-danger text-center d-none" role="alert" id="login-messages"></div>

    <form method="POST" action="" class="w-50 needs-validation " id="login-form" novalidate="novalidate" autocomplete="off">
           
            <h2 class="text-xl font-bold mb-2 text-center">Login</h2> 
            <hr>
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input type="email" class="form-control" id="email" name="email" placeholder="e.g., john.doe@example.com" required>
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input type="password" class="form-control" id="password" name="password" placeholder="Enter your password" required>
            </div>
            
            <hr>
            <button type="button" class="btn btn-primary w-100" onclick="val()">Login</button>
            <p class="mt-2">
                <small><a href="/forgot-password">Forgot Password?</a></small>
            </p>
        </form>
{{end}}

{{define "js"}}

<script>

    let loginMessages = document.getElementById('login-messages');

    function showError(message) {
        loginMessages.classList.add('alert-danger');
        loginMessages.classList.remove('alert-success');
        loginMessages.textContent = message;
        loginMessages.classList.remove('d-none');
    }
    function showSuccess() {
        loginMessages.classList.add('alert-success');
        loginMessages.classList.remove('alert-danger');
        loginMessages.textContent = 'Login successful!';
        loginMessages.classList.remove('d-none');
    }
    function val() {
         this.event.preventDefault();
            this.event.stopPropagation();
        let form = document.getElementById('login-form');
        if(form.checkValidity() === false) {
           
           form.classList.add('was-validated');
           return;
        }
        form.classList.remove('was-validated');

        let payload = {
            email: document.getElementById('email').value,
            password: document.getElementById('password').value
        };
        const requestOptions = {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json',
            },
            body: JSON.stringify(payload)
        };
        fetch("{{.API}}/api/authenticate", requestOptions)
            .then(response => response.json())
            .then(response => {
                console.log(response);
                if((response.error) == false) {
                  localStorage.setItem('token', response.authentication_token.token);  
                  localStorage.setItem('token_expiry', response.authentication_token.expiry);
                  showSuccess();
                    setTimeout(() => {
                        location.href = "/";
                    }, 1000);
                } else {
                    showError(response.message);
                }
            })
        
    }
</script>

{{end}}